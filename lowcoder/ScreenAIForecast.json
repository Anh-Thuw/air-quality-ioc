{"applicationInfo":{"name":"ScreenAIForecast","createAt":1786631337337,"createBy":"6a76277a3dce5f3fbb6b7294","applicationId":"6a7dd4a9b2449f42c2d4ba6a","applicationType":2},"applicationDSL":{"ui":{"compType":"module","comp":{"events":{"enableEventTestMessage":true},"autoScaleCompHeight":true,"container":{"layout":{"5f1740e6":{"i":"5f1740e6","h":91,"w":24,"x":0,"y":0,"pos":0}},"items":{"5f1740e6":{"compType":"custom","comp":{"model":"{{{\n  stations: getAIStations.data || [],\n  forecasts: getAIForecasts.data || [],\n  history: getAIHistory.data || [],\n  selectedStationId: selectedStationId.value\n}}}","code":"<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;font-family:Inter,Arial,sans-serif;background:#f5f8fc;color:#172033}\n.wrap{padding:4px}\n.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-bottom:18px}\n.title{font-size:16px;font-weight:800;color:#123d70;margin-right:auto}\n.switcher{display:flex;align-items:center;gap:8px;padding:9px 12px;background:#fff;border:1px solid #dce4ef;border-radius:10px;box-shadow:0 2px 8px rgba(15,48,82,.04)}\n.switcher select{border:0;outline:0;background:transparent;color:#172033;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;min-width:160px}\n.tabs{display:flex;flex-wrap:wrap;background:#eef2f7;border:1px solid #dce4ef;border-radius:10px;padding:3px;gap:2px}\n.tab{padding:7px 14px;border-radius:7px;font-size:12.5px;font-weight:700;color:#63758e;cursor:pointer}\n.tab:hover{background:#f8fafc}\n.tab.active{background:#fff;color:#1264c5;box-shadow:0 1px 3px rgba(15,48,82,.15)}\n.top-grid{display:grid;grid-template-columns:270px minmax(0,1fr);gap:16px;margin-bottom:18px}\n.card{background:#fff;border:1px solid #e0e7f0;border-radius:14px;box-shadow:0 3px 12px rgba(21,49,80,.045)}\n.aqi-card{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:22px;text-align:center}\n.card-label{color:#63758e;font-size:12px;font-weight:700;text-transform:uppercase;margin-bottom:14px}\n.aqi-ring{width:110px;height:110px;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative}\n.aqi-ring::before{content:\"\";position:absolute;width:92px;height:92px;border-radius:50%;background:#fff}\n.aqi-value{position:relative;z-index:2;font-size:32px;font-weight:800}\n.aqi-label{margin-top:12px;padding:5px 12px;border-radius:999px;font-size:11px;font-weight:800;text-transform:uppercase}\n.aqi-sub{margin-top:8px;color:#8a99ad;font-size:11.5px}\n.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}\n.stat{background:#f8fafc;border:1px solid #e5ebf2;border-radius:11px;padding:16px}\n.stat-label{color:#77879c;font-size:11px;font-weight:700;text-transform:uppercase}\n.stat-value{margin-top:8px;font-size:22px;font-weight:800;color:#172033}\n.chart-card{padding:20px;margin-bottom:18px}\n.chart-box{position:relative;height:280px}\n.horizon-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:18px}\n.horizon-item{text-align:center;padding:12px 8px;border:1px solid #e0e7f0;border-radius:11px;background:#f8fafc;cursor:pointer;transition:.2s}\n.horizon-item:hover{transform:translateY(-2px)}\n.horizon-item.active{border-color:#1264c5;background:#eef6ff}\n.horizon-num{font-size:20px;font-weight:800;margin:5px 0}\n.horizon-tag{font-size:10.5px;font-weight:800;padding:3px 8px;border-radius:999px;display:inline-block}\n.state-msg{padding:36px;text-align:center;color:#77879c}\n\n@media(max-width:800px){\n  .top-grid{grid-template-columns:1fr}\n  .stats-grid{grid-template-columns:repeat(2,1fr)}\n  .horizon-grid{grid-template-columns:repeat(2,1fr)}\n}\n</style>\n\n<div class=\"wrap\">\n  <div id=\"root\">\n    <div class=\"state-msg\">Đang tải dữ liệu...</div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n\n<script>\nlet stations=[];\nlet forecasts=[];\nlet history=[];\nlet selectedStationId=null;\nlet selectedHorizon=null;\nlet chartInstance=null;\nlet hasReceivedModel=false;\n\nfunction safeArray(value){\n  return Array.isArray(value)?value:[];\n}\n\nfunction safeNumber(value){\n  const number=Number(value);\n  return Number.isFinite(number)?number:null;\n}\n\nfunction roundValue(value){\n  const number=safeNumber(value);\n  return number===null?\"--\":number.toFixed(2);\n}\n\nfunction fmtTime(value){\n  if(!value)return\"--\";\n  const date=new Date(String(value).replace(\" \",\"T\"));\n  if(Number.isNaN(date.getTime())){\n    return String(value);\n  }\n  const hh=String(date.getHours()).padStart(2,\"0\");\n  const mm=String(date.getMinutes()).padStart(2,\"0\");\n  const dd=String(date.getDate()).padStart(2,\"0\");\n  const mo=String(date.getMonth()+1).padStart(2,\"0\");\n  return `${hh}:${mm} ${dd}/${mo}`;\n}\n\nfunction getAqiInfo(aqi){\n  const value=safeNumber(aqi);\n  if(value===null){\n    return{label:\"Chưa có dữ liệu\",color:\"#94a3b8\",bg:\"#f8fafc\",border:\"#cbd5e1\"};\n  }\n  if(value<=50){\n    return{label:\"Tốt\",color:\"#10b981\",bg:\"#ecfdf5\",border:\"#a7f3d0\"};\n  }\n  if(value<=100){\n    return{label:\"Trung bình\",color:\"#f59e0b\",bg:\"#fffaf0\",border:\"#f8d77a\"};\n  }\n  if(value<=150){\n    return{label:\"Kém\",color:\"#f97316\",bg:\"#fff7ed\",border:\"#fed7aa\"};\n  }\n  if(value<=200){\n    return{label:\"Xấu\",color:\"#ef4444\",bg:\"#fef2f2\",border:\"#fecaca\"};\n  }\n  return{label:\"Nguy hại\",color:\"#a855f7\",bg:\"#faf5ff\",border:\"#e9d5ff\"};\n}\n\n/* Chỗ quan trọng: runQuery cần truyền OBJECT { queryName } */\nasync function updateStation(id){\n  const stationId = Number(id);\n  if(!Number.isFinite(stationId) || stationId <= 0) return;\n\n  selectedStationId = stationId;\n  paintLoading();\n\n  try {\n    await Lowcoder.updateModel({ selectedStationId: stationId });\n\n    if (typeof Lowcoder.runQuery === \"function\") {\n      await Lowcoder.runQuery({ queryName: \"syncStation\" });\n    }\n  } catch(err){\n    console.error(\"updateStation failed:\", err);\n    setTimeout(() => {\n      if (typeof Lowcoder.runQuery === \"function\") {\n        Lowcoder.runQuery({ queryName: \"syncStation\" });\n      }\n    }, 150);\n  }\n}\n\nfunction paintLoading(){\n  const root=document.getElementById(\"root\");\n  if(!root)return;\n  const body=document.getElementById(\"body\");\n  if(!body)return;\n  body.innerHTML=`\n    <div class=\"card\">\n      <div class=\"state-msg\">\n        Đang tải dữ liệu trạm...\n      </div>\n    </div>\n  `;\n}\n\nfunction selectHorizon(horizon){\n  const value=safeNumber(horizon);\n  if(value===null){\n    return;\n  }\n  selectedHorizon=value;\n  paint();\n}\n\nfunction applyModel(payload){\n  const data=\n    payload&&payload.model\n      ?payload.model\n      :payload||{};\n\n  stations=safeArray(data.stations);\n  forecasts=safeArray(data.forecasts);\n  history=safeArray(data.history);\n\n  const modelStationId=safeNumber(data.selectedStationId);\n\n  if(modelStationId!==null){\n    selectedStationId=modelStationId;\n  }\n\n  if(selectedStationId===null&&stations.length>0){\n    selectedStationId=safeNumber(stations[0].id);\n  }\n\n  const horizons=forecasts\n    .map(item=>safeNumber(item.horizon_hours))\n    .filter(value=>value!==null);\n\n  if(\n    horizons.length>0&&\n    (selectedHorizon===null||!horizons.includes(selectedHorizon))\n  ){\n    selectedHorizon=Math.min(...horizons);\n  }\n\n  hasReceivedModel=true;\n  paint();\n}\n\nfunction paint(){\n  const root=document.getElementById(\"root\");\n  if(!root)return;\n\n  if(!hasReceivedModel){\n    root.innerHTML=`<div class=\"state-msg\">Đang tải dữ liệu...</div>`;\n    return;\n  }\n\n  const sortedForecasts=[...forecasts].sort(\n    (a,b)=>Number(a.horizon_hours)-Number(b.horizon_hours)\n  );\n\n  const stationOptions=stations\n    .map(station=>{\n      const stationId=safeNumber(station.id);\n      const selected=stationId===selectedStationId?\"selected\":\"\";\n      return `<option value=\"${station.id}\" ${selected}>${station.name||\"Không tên\"}</option>`;\n    })\n    .join(\"\");\n\n  const tabsHtml=sortedForecasts\n    .map(forecast=>{\n      const horizon=safeNumber(forecast.horizon_hours);\n      const active=horizon===selectedHorizon?\"active\":\"\";\n      return `<div class=\"tab ${active}\" onclick=\"selectHorizon(${horizon})\">+${horizon}h</div>`;\n    })\n    .join(\"\");\n\n  root.innerHTML=`\n    <div class=\"toolbar\">\n      <div class=\"title\">Dự báo chất lượng không khí AI</div>\n      <div class=\"switcher\">\n        <span style=\"color:#1264c5;font-size:18px\">📍</span>\n        <select onchange=\"updateStation(this.value)\">\n          ${stationOptions||\"<option>Không có trạm</option>\"}\n        </select>\n      </div>\n      <div class=\"tabs\">\n        ${tabsHtml||'<div class=\"tab\">--</div>'}\n      </div>\n    </div>\n    <div id=\"body\"></div>\n  `;\n\n  const body=document.getElementById(\"body\");\n\n  if(stations.length===0){\n    body.innerHTML=`\n      <div class=\"card\">\n        <div class=\"state-msg\">\n          Chưa có dữ liệu trạm.<br><br>Kiểm tra query getAIStations.\n        </div>\n      </div>\n    `;\n    return;\n  }\n\n  if(sortedForecasts.length===0){\n    body.innerHTML=`\n      <div class=\"card\">\n        <div class=\"state-msg\">Chưa có dữ liệu dự báo cho trạm này.</div>\n      </div>\n    `;\n    return;\n  }\n\n  const current=\n    sortedForecasts.find(item=>safeNumber(item.horizon_hours)===selectedHorizon)\n    || sortedForecasts[0];\n\n  const aqiInfo=getAqiInfo(current.predicted_aqius);\n\n  const sortedHistory=[...history].sort((a,b)=>new Date(a.ts)-new Date(b.ts));\n\n  const latestActual=\n    sortedHistory.length>0\n      ?sortedHistory[sortedHistory.length-1]\n      :null;\n\n  body.innerHTML=`\n    <div class=\"top-grid\">\n      <div class=\"card aqi-card\">\n        <div class=\"card-label\">AQI dự báo +${current.horizon_hours}h</div>\n        <div class=\"aqi-ring\" style=\"background:${aqiInfo.color}\">\n          <div class=\"aqi-value\">${roundValue(current.predicted_aqius)}</div>\n        </div>\n        <div class=\"aqi-label\" style=\"color:${aqiInfo.color};background:${aqiInfo.bg};border:1px solid ${aqiInfo.border};\">\n          ${aqiInfo.label}\n        </div>\n        <div class=\"aqi-sub\">Thời điểm: ${fmtTime(current.forecast_for)}</div>\n      </div>\n\n      <div class=\"card\" style=\"padding:20px\">\n        <div class=\"card-label\">Chỉ số mô hình</div>\n        <div class=\"stats-grid\">\n          <div class=\"stat\">\n            <div class=\"stat-label\">AQI hiện tại</div>\n            <div class=\"stat-value\">${latestActual?roundValue(latestActual.aqius):\"--\"}</div>\n          </div>\n          <div class=\"stat\">\n            <div class=\"stat-label\">MAE</div>\n            <div class=\"stat-value\">${roundValue(current.mae)}</div>\n          </div>\n          <div class=\"stat\">\n            <div class=\"stat-label\">RMSE</div>\n            <div class=\"stat-value\">${roundValue(current.rmse)}</div>\n          </div>\n          <div class=\"stat\">\n            <div class=\"stat-label\">Cập nhật lúc</div>\n            <div class=\"stat-value\" style=\"font-size:16px\">${fmtTime(current.created_at)}</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"card chart-card\">\n      <div class=\"card-label\">AQI thực tế so với dự báo AI</div>\n      <div class=\"chart-box\"><canvas id=\"aqiChart\"></canvas></div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-label\" style=\"padding:16px 18px 0\">Tất cả mốc dự báo</div>\n      <div class=\"horizon-grid\">\n        ${\n          sortedForecasts\n            .map(forecast=>{\n              const info=getAqiInfo(forecast.predicted_aqius);\n              const horizon=safeNumber(forecast.horizon_hours);\n              const active=horizon===selectedHorizon?\"active\":\"\";\n              return `\n                <div class=\"horizon-item ${active}\" onclick=\"selectHorizon(${horizon})\">\n                  <div class=\"stat-label\">+${horizon}H · ${fmtTime(forecast.forecast_for)}</div>\n                  <div class=\"horizon-num\">${roundValue(forecast.predicted_aqius)}</div>\n                  <span class=\"horizon-tag\" style=\"color:${info.color};background:${info.bg};\">${info.label}</span>\n                </div>\n              `;\n            })\n            .join(\"\")\n        }\n      </div>\n    </div>\n  `;\n\n  renderChart(sortedHistory, sortedForecasts);\n}\n\nfunction renderChart(sortedHistory, sortedForecasts){\n  if(typeof Chart===\"undefined\"){\n    return;\n  }\n  const canvas=document.getElementById(\"aqiChart\");\n  if(!canvas){\n    return;\n  }\n\n  const histSlice=sortedHistory.slice(-12);\n\n  const labels=[\n    ...histSlice.map(item=>fmtTime(item.ts)),\n    ...sortedForecasts.map(item=>fmtTime(item.forecast_for))\n  ];\n\n  const actualData=[\n    ...histSlice.map(item=>safeNumber(item.aqius)),\n    ...sortedForecasts.map(()=>null)\n  ];\n\n  const lastActual=\n    histSlice.length>0\n      ?safeNumber(histSlice[histSlice.length-1].aqius)\n      :null;\n\n  const aiData=[\n    ...histSlice.slice(0,-1).map(()=>null),\n    lastActual,\n    ...sortedForecasts.map(item=>safeNumber(item.predicted_aqius))\n  ];\n\n  const context=canvas.getContext(\"2d\");\n\n  if(chartInstance){\n    chartInstance.destroy();\n    chartInstance=null;\n  }\n\n  chartInstance=new Chart(context,{\n    type:\"line\",\n    data:{\n      labels:labels,\n      datasets:[\n        {\n          label:\"AQI thực tế\",\n          data:actualData,\n          borderColor:\"#172033\",\n          backgroundColor:\"rgba(23,32,51,.08)\",\n          borderWidth:3,\n          tension:.35,\n          spanGaps:false\n        },\n        {\n          label:\"Dự báo AI\",\n          data:aiData,\n          borderColor:\"#1264c5\",\n          backgroundColor:\"rgba(18,100,197,.08)\",\n          borderDash:[6,4],\n          borderWidth:3,\n          tension:.35,\n          spanGaps:false\n        }\n      ]\n    },\n    options:{\n      responsive:true,\n      maintainAspectRatio:false,\n      interaction:{mode:\"index\",intersect:false},\n      plugins:{legend:{position:\"top\"}},\n      scales:{\n        x:{grid:{display:false},ticks:{color:\"#8291a6\",font:{size:10}}},\n        y:{beginAtZero:true,grid:{color:\"#edf1f5\"},ticks:{color:\"#8291a6\"}}\n      }\n    }\n  });\n}\n\nif(typeof Lowcoder!==\"undefined\"&&typeof Lowcoder.subscribe===\"function\"){\n  Lowcoder.subscribe(function(payload){\n    applyModel(payload);\n  });\n}else{\n  applyModel({stations:[],forecasts:[],history:[],selectedStationId:null});\n}\n</script>","showDataLoadingIndicators":false,"preventStyleOverwriting":false,"appliedThemeId":"","version":"latest"},"name":"custom1"}}},"containerSize":{"height":93,"width":24},"containerRowCount":91,"showDataLoadingIndicators":false,"preventStyleOverwriting":false,"appliedThemeId":"","version":"latest"}},"queries":[{"compType":"postgres","comp":{"commandType":"INSERT","command":{"table":"","changeSet":{"compType":"KEY_VALUE_PAIRS","comp":[{"column":"","value":""}]}},"mode":"SQL","sql":"SELECT id, name, city, latitude, longitude\nFROM stations\nORDER BY id;","disablePreparedStatement":false},"id":"ajpy4fhmbjtn42515ug1xcjl","name":"getAIStations","order":1789128921510,"datasourceId":"6a76284f3dce5f3fbb6b72ac","triggerType":"automatic","onEvent":[{"name":"success","handler":{"compType":"executeQuery","comp":{"queryName":"syncStation","queryVariables":[]},"condition":"","slowdown":"debounce","delay":""}}],"notification":{"showSuccess":true,"showFail":true,"fail":[{}]},"timeout":"","confirmationModal":{},"variables":[],"periodic":false,"periodicTime":"","cancelPrevious":false,"depQueryName":"","delayTime":""},{"compType":"postgres","comp":{"commandType":"INSERT","command":{"table":"","changeSet":{"compType":"KEY_VALUE_PAIRS","comp":[{"column":"","value":""}]}},"mode":"SQL","sql":"SELECT DISTINCT ON (horizon_hours)\n    id,\n    station_id,\n    model_name,\n    forecast_for,\n    horizon_hours,\n    predicted_aqius,\n    predicted_pm25,\n    confidence,\n    mae,\n    rmse,\n    created_at\nFROM forecasts\nWHERE station_id = {{ selectedStationId.value || 1 }}\nORDER BY horizon_hours, created_at DESC;","disablePreparedStatement":false},"id":"fkqi9o3q7frbwsxb08hfqi6y","name":"getAIForecasts","order":1789129562857,"datasourceId":"6a76284f3dce5f3fbb6b72ac","triggerType":"automatic","onEvent":[],"notification":{"showSuccess":true,"showFail":true,"fail":[{}]},"timeout":"","confirmationModal":{},"variables":[],"periodic":false,"periodicTime":"","cancelPrevious":false,"depQueryName":"","delayTime":""},{"compType":"postgres","comp":{"commandType":"INSERT","command":{"table":"","changeSet":{"compType":"KEY_VALUE_PAIRS","comp":[{"column":"","value":""}]}},"mode":"SQL","sql":"SELECT\n    ts,\n    ts_vn,\n    aqius,\n    aqicn,\n    mainus\nFROM pollution_readings\nWHERE station_id = {{ selectedStationId.value || 1 }}\n  AND aqius IS NOT NULL\nORDER BY ts DESC\nLIMIT 24;","disablePreparedStatement":false},"id":"the1ymsoivci456ubrli63uu","name":"getAIHistory","order":1789129582672,"datasourceId":"6a76284f3dce5f3fbb6b72ac","triggerType":"automatic","onEvent":[],"notification":{"showSuccess":true,"showFail":true,"fail":[{}]},"timeout":"","confirmationModal":{},"variables":[],"periodic":false,"periodicTime":"","cancelPrevious":false,"depQueryName":"","delayTime":""},{"compType":"js","comp":{"script":"const stationId = Number(\n  custom1.model?.selectedStationId\n);\n\nconsole.log(\"stationId:\", stationId);\n\nif(!Number.isFinite(stationId)){\n  throw new Error(\"Không nhận được Station ID\");\n}\n\nselectedStationId.setValue(stationId);\n\nreturn {\n  stationId\n};"},"id":"um5z9dmmmgi4yl50tb43hqu4","name":"syncStation","order":1789403379723,"datasourceId":"#JS_CODE","triggerType":"manual","onEvent":[{"name":"success","handler":{"compType":"executeQuery","comp":{"queryName":"getAIForecasts","queryVariables":[]},"condition":"","slowdown":"debounce","delay":""}},{"name":"success","handler":{"compType":"executeQuery","comp":{"queryName":"getAIHistory","queryVariables":[]},"condition":"","slowdown":"debounce","delay":""}}],"notification":{"showSuccess":false,"showFail":true,"fail":[{}]},"timeout":"","confirmationModal":{},"variables":[],"periodic":false,"periodicTime":"","cancelPrevious":false,"depQueryName":"","delayTime":""}],"tempStates":[{"name":"selectedStationId","value":"1"}],"refTree":{"value":"","items":[{"value":"getAIStations"},{"value":"getAIForecasts"},{"value":"getAIHistory"},{"value":"selectedStationId"},{"value":"syncStation"}]},"hooks":[{"compType":"urlParams","comp":{},"name":"url"},{"compType":"dayJsLib","comp":{},"name":"dayjs"},{"compType":"lodashJsLib","comp":{},"name":"_"},{"compType":"utils","comp":{},"name":"utils"},{"compType":"message","comp":{},"name":"message"},{"compType":"toast","comp":{},"name":"toast"},{"compType":"localStorage","comp":{},"name":"localStorage"},{"compType":"currentUser","comp":{},"name":"currentUser"},{"compType":"screenInfo","comp":{},"name":"screenInfo"},{"compType":"theme","comp":{},"name":"theme"}],"settings":{"title":"","description":"","category":"Business","showHeaderInPublic":true,"themeId":"default","preventAppStylesOverwriting":true,"disableCollision":false,"lowcoderCompVersion":"latest","maxWidth":{"dropdown":"1440","input":"1440"},"gridRowCount":"Infinity","gridPaddingX":"0","gridPaddingY":"0"},"preload":{"script":"","css":"","globalCSS":""}}}