{"applicationInfo":{"name":"ScreenStations","createAt":1786631359179,"createBy":"6a76277a3dce5f3fbb6b7294","applicationId":"6a7dd4bfb2449f42c2d4ba76","applicationType":2},"applicationDSL":{"ui":{"compType":"module","comp":{"events":{"enableEventTestMessage":true},"autoScaleCompHeight":true,"container":{"layout":{"1ae75fa3":{"i":"1ae75fa3","h":106,"w":24,"x":0,"y":0,"pos":0}},"items":{"1ae75fa3":{"compType":"custom","comp":{"model":"{\n  \"stations\": {{ get_stations_latest.data }},\n  \"history\": {{ get_station_history.data }},\n  \"selectedStationId\": {{ selectedStationId.value }}\n}","code":"<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>IOC Air Quality - Station Detail</title>\n\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..700,0..1,0\" rel=\"stylesheet\">\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n\n  <style>\n    * { box-sizing: border-box; }\n    html, body {\n      margin: 0; padding: 0; width: 100%; min-height: 100%;\n      font-family: \"Inter\", sans-serif; background: #f5f8fc; color: #172033;\n    }\n    body { overflow-x: hidden; }\n    button, select { font-family: inherit; }\n    button { border: 0; }\n    .material-symbols-outlined {\n      font-family: \"Material Symbols Outlined\"; font-weight: normal; font-style: normal;\n      font-size: 20px; line-height: 1; letter-spacing: normal; text-transform: none;\n      display: inline-block; white-space: nowrap; word-wrap: normal; direction: ltr;\n      -webkit-font-feature-settings: \"liga\"; -webkit-font-smoothing: antialiased;\n    }\n    .page { width: 100%; min-height: 100vh; padding: 26px 30px 40px; background: linear-gradient(180deg, #f8fafc 0%, #f4f7fb 100%); }\n    .page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; padding-bottom: 22px; border-bottom: 1px solid #dfe6ef; }\n    .header-left { min-width: 0; }\n    .breadcrumb { display: flex; align-items: center; gap: 7px; color: #1264c5; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; margin-bottom: 7px; }\n    .breadcrumb .material-symbols-outlined { font-size: 18px; }\n    .station-title { margin: 0; color: #123d70; font-size: 30px; line-height: 1.2; font-weight: 800; }\n    .station-subtitle { margin-top: 8px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; color: #708099; font-size: 13px; }\n    .station-subtitle .dot { width: 4px; height: 4px; border-radius: 50%; background: #aeb8c7; }\n    .header-right { display: flex; align-items: center; gap: 12px; }\n    .station-switcher { min-width: 280px; display: flex; align-items: center; gap: 9px; padding: 10px 12px; background: #ffffff; border: 1px solid #dce4ef; border-radius: 10px; box-shadow: 0 2px 8px rgba(15, 48, 82, .04); }\n    .station-switcher .material-symbols-outlined { color: #1264c5; font-size: 21px; }\n    .station-switcher select { width: 100%; border: 0; outline: 0; background: transparent; color: #172033; font-size: 13px; font-weight: 600; cursor: pointer; }\n    .status { display: flex; align-items: center; gap: 7px; padding: 9px 13px; border-radius: 999px; background: #effcf6; border: 1px solid #b8efd5; color: #079669; font-size: 12px; font-weight: 700; white-space: nowrap; }\n    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; }\n    .station-navigation { display: flex; align-items: center; gap: 10px; margin-top: 18px; }\n    .nav-button { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 9px; background: #ffffff; border: 1px solid #dce4ef; color: #52657d; cursor: pointer; transition: .2s ease; }\n    .nav-button:hover:not(:disabled) { background: #edf5ff; color: #1264c5; border-color: #b9d5f5; }\n    .nav-button:disabled { opacity: .4; cursor: not-allowed; }\n    .station-counter { color: #6e7d91; font-size: 12px; font-weight: 600; }\n    .view-all-button { margin-left: auto; display: flex; align-items: center; gap: 6px; padding: 9px 13px; border-radius: 8px; background: #ffffff; border: 1px solid #dce4ef; color: #1264c5; font-size: 12px; font-weight: 700; cursor: pointer; transition: .2s ease; }\n    .view-all-button:hover { background: #edf5ff; }\n    .card { background: #ffffff; border: 1px solid #e0e7f0; border-radius: 14px; box-shadow: 0 3px 12px rgba(21, 49, 80, .045); }\n    .top-grid { display: grid; grid-template-columns: 310px minmax(0, 1fr); gap: 18px; margin-top: 20px; }\n    .aqi-card { min-height: 275px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; }\n    .card-title { width: 100%; margin-bottom: 18px; color: #63758e; font-size: 14px; font-weight: 700; }\n    .aqi-ring { width: 128px; height: 128px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; background: conic-gradient(#f59e0b 0deg, #f59e0b 360deg); }\n    .aqi-ring::before { content: \"\"; position: absolute; width: 108px; height: 108px; border-radius: 50%; background: #ffffff; }\n    .aqi-value { position: relative; z-index: 2; color: #172033; font-size: 39px; font-weight: 800; line-height: 1; }\n    .aqi-label { margin-top: 14px; padding: 6px 12px; border-radius: 999px; background: #fffaf0; border: 1px solid #f8d77a; color: #d97706; font-size: 11px; font-weight: 800; text-transform: uppercase; text-align: center; }\n    .aqi-main-pollutant { margin-top: 9px; color: #8a99ad; font-size: 12px; }\n    .weather-card { padding: 22px; }\n    .weather-title { color: #63758e; font-size: 14px; font-weight: 700; margin-bottom: 16px; }\n    .weather-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }\n    .weather-item { min-height: 165px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 18px; background: #f8fafc; border: 1px solid #e5ebf2; border-radius: 11px; }\n    .weather-icon { margin-bottom: 11px; color: #1264c5; }\n    .weather-icon .material-symbols-outlined { font-size: 27px; }\n    .weather-value { color: #172033; font-size: 22px; font-weight: 800; }\n    .weather-label { margin-top: 6px; color: #78889d; font-size: 11px; font-weight: 600; text-align: center; }\n    .pollutant-card { margin-top: 18px; padding: 21px; }\n    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n    .section-title { color: #63758e; font-size: 14px; font-weight: 700; }\n    .section-note { color: #9aa7b8; font-size: 11px; }\n    .pollutant-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }\n    .pollutant { position: relative; min-height: 105px; padding: 15px; background: #ffffff; border: 1px solid #e0e7f0; border-top: 4px solid #10b981; border-radius: 11px; cursor: help; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }\n    .pollutant.warning { border-top-color: #f59e0b; }\n    .pollutant:hover { transform: translateY(-3px); border-color: #c8d7e8; box-shadow: 0 8px 22px rgba(22, 56, 92, .10); }\n    .pollutant-top { display: flex; justify-content: space-between; align-items: center; }\n    .pollutant-name { color: #62748d; font-size: 12px; font-weight: 800; }\n    .info-icon { color: #a2afbe; font-size: 16px; }\n    .pollutant-value { margin-top: 8px; color: #172033; font-size: 25px; font-weight: 800; line-height: 1; }\n    .pollutant-unit { margin-left: 3px; color: #9aa8ba; font-size: 10px; font-weight: 600; }\n    .pollutant-tooltip { position: absolute; left: 50%; bottom: calc(100% + 12px); width: 250px; padding: 13px 14px; transform: translateX(-50%) translateY(6px); opacity: 0; visibility: hidden; pointer-events: none; background: #172033; color: #ffffff; border-radius: 9px; box-shadow: 0 10px 28px rgba(0, 0, 0, .20); transition: opacity .18s ease, transform .18s ease, visibility .18s ease; z-index: 100; }\n    .pollutant:hover .pollutant-tooltip { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }\n    .pollutant-tooltip::after { content: \"\"; position: absolute; left: 50%; bottom: -6px; width: 12px; height: 12px; transform: translateX(-50%) rotate(45deg); background: #172033; }\n    .tooltip-title { position: relative; z-index: 2; margin-bottom: 5px; color: #ffffff; font-size: 12px; font-weight: 800; }\n    .tooltip-description { position: relative; z-index: 2; color: #cbd5e1; font-size: 11px; line-height: 1.55; }\n    .tooltip-unit { margin-top: 7px; color: #93c5fd; font-size: 10px; font-weight: 700; }\n    .bottom-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr); gap: 18px; margin-top: 18px; }\n    .chart-card { min-height: 330px; padding: 21px; }\n    .chart-container { position: relative; width: 100%; height: 245px; margin-top: 4px; padding: 4px 4px 0; background: linear-gradient(180deg, #fbfdff 0%, #ffffff 100%); border: 1px solid #e7edf4; border-radius: 10px; }\n    .info-card { padding: 21px; min-height: 330px; }\n    .info-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #edf1f5; }\n    .info-row:last-child { border-bottom: 0; }\n    .info-label { display: flex; align-items: center; gap: 8px; color: #77879c; font-size: 12px; }\n    .info-label .material-symbols-outlined { color: #1264c5; font-size: 18px; }\n    .info-value { color: #25354c; font-size: 12px; font-weight: 700; text-align: right; }\n    .modal-overlay { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(15, 23, 42, .38); opacity: 0; visibility: hidden; transition: .2s ease; z-index: 9999; }\n    .modal-overlay.show { opacity: 1; visibility: visible; }\n    .modal { width: min(720px, 100%); max-height: 80vh; overflow: hidden; background: #ffffff; border-radius: 16px; box-shadow: 0 25px 70px rgba(15, 23, 42, .25); }\n    .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid #e6ebf1; }\n    .modal-title { color: #163e70; font-size: 16px; font-weight: 800; }\n    .close-modal { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: #f5f7fa; color: #65758a; cursor: pointer; }\n    .modal-body { max-height: calc(80vh - 70px); overflow-y: auto; padding: 16px; }\n    .station-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n    .station-option { display: flex; align-items: center; justify-content: space-between; padding: 13px; background: #ffffff; border: 1px solid #e1e8f0; border-radius: 10px; cursor: pointer; transition: .18s ease; }\n    .station-option:hover { background: #f5f9ff; border-color: #b9d5f5; }\n    .station-option.active { background: #eef6ff; border-color: #8dbce9; }\n    .station-option-left { min-width: 0; }\n    .station-option-name { color: #26384f; font-size: 12px; font-weight: 700; }\n    .station-option-location { margin-top: 4px; color: #8a98aa; font-size: 10px; }\n    .station-aqi { padding: 4px 7px; border-radius: 6px; background: #ecfdf5; color: #059669; font-size: 10px; font-weight: 800; }\n    @media (max-width: 1100px) {\n      .top-grid { grid-template-columns: 1fr; }\n      .pollutant-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n      .weather-grid { grid-template-columns: repeat(2, 1fr); }\n      .bottom-grid { grid-template-columns: 1fr; }\n    }\n    @media (max-width: 760px) {\n      .page { padding: 18px; }\n      .page-header { flex-direction: column; }\n      .header-right { width: 100%; flex-direction: column; align-items: stretch; }\n      .station-switcher { width: 100%; }\n      .status { width: fit-content; }\n      .pollutant-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n      .station-list { grid-template-columns: 1fr; }\n    }\n    @media (max-width: 480px) {\n      .station-title { font-size: 24px; }\n      .weather-grid { grid-template-columns: 1fr; }\n      .pollutant-grid { grid-template-columns: 1fr 1fr; }\n      .pollutant-tooltip { width: 210px; }\n    }\n  </style>\n</head>\n\n<body>\n<div class=\"page\">\n\n  <header class=\"page-header\">\n    <div class=\"header-left\">\n      <div class=\"breadcrumb\">\n        <span class=\"material-symbols-outlined\">location_on</span>\n        <span id=\"stationLocation\">ĐÀ NẴNG, VIỆT NAM</span>\n      </div>\n      <h1 class=\"station-title\" id=\"stationName\">Đang tải...</h1>\n      <div class=\"station-subtitle\">\n        <span id=\"stationCoordinates\">--</span>\n        <span class=\"dot\"></span>\n        <span id=\"lastUpdated\">Đang tải dữ liệu...</span>\n      </div>\n    </div>\n\n    <div class=\"header-right\">\n      <div class=\"station-switcher\">\n        <span class=\"material-symbols-outlined\">swap_vert</span>\n        <select id=\"stationSelect\" onchange=\"changeStation(this.value)\"></select>\n      </div>\n      <div class=\"status\" id=\"statusBox\">\n        <span class=\"status-dot\" id=\"statusDot\"></span>\n        <span id=\"statusText\">Đang tải</span>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"station-navigation\">\n    <button class=\"nav-button\" id=\"prevButton\" onclick=\"previousStation()\">\n      <span class=\"material-symbols-outlined\">chevron_left</span>\n    </button>\n    <button class=\"nav-button\" id=\"nextButton\" onclick=\"nextStation()\">\n      <span class=\"material-symbols-outlined\">chevron_right</span>\n    </button>\n    <span class=\"station-counter\" id=\"stationCounter\">Trạm -- / --</span>\n    <button class=\"view-all-button\" onclick=\"openStationModal()\">\n      <span class=\"material-symbols-outlined\">grid_view</span>\n      Xem tất cả trạm\n    </button>\n  </div>\n\n  <div class=\"top-grid\">\n    <section class=\"card aqi-card\">\n      <div class=\"card-title\">Chỉ số AQI hiện tại</div>\n      <div class=\"aqi-ring\" id=\"aqiRing\">\n        <div class=\"aqi-value\" id=\"aqiValue\">--</div>\n      </div>\n      <div class=\"aqi-label\" id=\"aqiLabel\">ĐANG TẢI</div>\n      <div class=\"aqi-main-pollutant\">\n        Chất ô nhiễm chính: <strong id=\"mainPollutant\">--</strong>\n      </div>\n    </section>\n\n    <section class=\"card weather-card\">\n      <div class=\"weather-title\">Thông tin thời tiết</div>\n      <div class=\"weather-grid\">\n        <div class=\"weather-item\">\n          <div class=\"weather-icon\"><span class=\"material-symbols-outlined\">device_thermostat</span></div>\n          <div class=\"weather-value\" id=\"temperature\">--</div>\n          <div class=\"weather-label\">Nhiệt độ</div>\n        </div>\n        <div class=\"weather-item\">\n          <div class=\"weather-icon\"><span class=\"material-symbols-outlined\">humidity_mid</span></div>\n          <div class=\"weather-value\" id=\"humidity\">--</div>\n          <div class=\"weather-label\">Độ ẩm</div>\n        </div>\n        <div class=\"weather-item\">\n          <div class=\"weather-icon\"><span class=\"material-symbols-outlined\">air</span></div>\n          <div class=\"weather-value\" id=\"wind\">--</div>\n          <div class=\"weather-label\">Tốc độ gió</div>\n        </div>\n        <div class=\"weather-item\">\n          <div class=\"weather-icon\"><span class=\"material-symbols-outlined\">light_mode</span></div>\n          <div class=\"weather-value\" id=\"uv\">--</div>\n          <div class=\"weather-label\">Chỉ số UV</div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"card pollutant-card\">\n    <div class=\"section-header\">\n      <div class=\"section-title\">Nồng độ các chất ô nhiễm</div>\n      <div class=\"section-note\">Dữ liệu trực tiếp từ cơ sở dữ liệu</div>\n    </div>\n    <div class=\"pollutant-grid\" id=\"pollutantGrid\"></div>\n  </section>\n\n  <div class=\"bottom-grid\">\n    <section class=\"card chart-card\">\n      <div class=\"section-header\">\n        <div class=\"section-title\">Xu hướng AQI trong 24 giờ</div>\n        <div class=\"section-note\" id=\"chartStationName\">--</div>\n      </div>\n      <div class=\"chart-container\">\n        <canvas id=\"aqi24hChart\"></canvas>\n      </div>\n    </section>\n\n    <section class=\"card info-card\">\n      <div class=\"section-title\">Thông tin trạm</div>\n      <div class=\"info-row\">\n        <div class=\"info-label\"><span class=\"material-symbols-outlined\">location_city</span>Thành phố / tỉnh</div>\n        <div class=\"info-value\" id=\"infoCity\">--</div>\n      </div>\n      <div class=\"info-row\">\n        <div class=\"info-label\"><span class=\"material-symbols-outlined\">public</span>Quốc gia</div>\n        <div class=\"info-value\" id=\"infoCountry\">--</div>\n      </div>\n      <div class=\"info-row\">\n        <div class=\"info-label\"><span class=\"material-symbols-outlined\">north</span>Vĩ độ</div>\n        <div class=\"info-value\" id=\"infoLat\">--</div>\n      </div>\n      <div class=\"info-row\">\n        <div class=\"info-label\"><span class=\"material-symbols-outlined\">east</span>Kinh độ</div>\n        <div class=\"info-value\" id=\"infoLon\">--</div>\n      </div>\n      <div class=\"info-row\">\n        <div class=\"info-label\"><span class=\"material-symbols-outlined\">sensors</span>Trạng thái</div>\n        <div class=\"info-value\" id=\"infoStatus\">--</div>\n      </div>\n    </section>\n  </div>\n\n</div>\n\n<div class=\"modal-overlay\" id=\"stationModal\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <div class=\"modal-title\">Danh sách trạm quan trắc</div>\n      <button class=\"close-modal\" onclick=\"closeStationModal()\">\n        <span class=\"material-symbols-outlined\">close</span>\n      </button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"station-list\" id=\"stationList\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\n  /* =========================================================\n     STATE\n  ========================================================= */\n  let stations = [];\n  let historyData = [];\n  let selectedStationId = null;\n  let currentIndex = 0;\n  let aqi24hChart = null;\n\n  /* =========================================================\n     HELPERS\n  ========================================================= */\n  function safeArray(value) {\n    if (Array.isArray(value)) return value;\n    if (value && Array.isArray(value.data)) return value.data;\n    return [];\n  }\n\n  function safeNumber(value) {\n    if (value === null || value === undefined || value === \"\") return null;\n    const number = Number(value);\n    return Number.isFinite(number) ? number : null;\n  }\n\n  function displayValue(value, suffix = \"\") {\n    if (value === null || value === undefined || value === \"\") return \"--\";\n    return `${value}${suffix}`;\n  }\n\n  function getStationName(station) {\n    if (!station) return \"Trạm\";\n    const name = station.name || station.city || \"Không xác định\";\n    const names = {\n      \"Hoa Vang\": \"Trạm Hòa Vang\",\n      \"Cam Le\": \"Trạm Cẩm Lệ\",\n      \"Ngu Hanh Son\": \"Trạm Ngũ Hành Sơn\",\n      \"Lien Chieu\": \"Trạm Liên Chiểu\",\n      \"Thanh Khe\": \"Trạm Thanh Khê\",\n      \"Son Tra\": \"Trạm Sơn Trà\",\n      \"Kham Duc\": \"Trạm Khâm Đức\",\n      \"Tra My\": \"Trạm Trà My\",\n      \"Tien Phuoc\": \"Trạm Tiên Phước\",\n      \"Dong Giang\": \"Trạm Đông Giang\",\n      \"Doug An\": \"Trạm Đông Giang\",\n      \"Thanh My\": \"Trạm Thanh Mỹ\",\n      \"Que Son\": \"Trạm Quế Sơn\",\n      \"Ha Lam\": \"Trạm Hà Lam\",\n      \"Quang Nam\": \"Trạm Quảng Nam\",\n      \"Hoi An\": \"Trạm Hội An\"\n    };\n    return names[name] || `Trạm ${name}`;\n  }\n\n  function getLocationText(station) {\n    if (!station) return \"VIỆT NAM\";\n    const state = String(station.state || \"\")\n      .replace(\"Thanh Pho GJa Nang\", \"Đà Nẵng\")\n      .replace(\"Da Nang city\", \"Đà Nẵng\")\n      .replace(\"Tinh Quang Nam\", \"Quảng Nam\")\n      .replace(\"Hue\", \"Huế\");\n\n    if (state) return `${state}, Việt Nam`;\n    return station.city || \"Việt Nam\";\n  }\n\n  function getAqiInfo(aqi) {\n    if (aqi === null) {\n      return { label: \"CHƯA CÓ DỮ LIỆU\", color: \"#94a3b8\", background: \"#f8fafc\", border: \"#cbd5e1\" };\n    }\n    if (aqi <= 50) return { label: \"TỐT\", color: \"#10b981\", background: \"#ecfdf5\", border: \"#a7f3d0\" };\n    if (aqi <= 100) return { label: \"TRUNG BÌNH\", color: \"#f59e0b\", background: \"#fffaf0\", border: \"#f8d77a\" };\n    if (aqi <= 150) return { label: \"CÓ HẠI CHO NHÓM NHẠY CẢM\", color: \"#f97316\", background: \"#fff7ed\", border: \"#fed7aa\" };\n    if (aqi <= 200) return { label: \"CÓ HẠI\", color: \"#ef4444\", background: \"#fef2f2\", border: \"#fecaca\" };\n    if (aqi <= 300) return { label: \"RẤT CÓ HẠI\", color: \"#a855f7\", background: \"#faf5ff\", border: \"#e9d5ff\" };\n    return { label: \"NGUY HẠI\", color: \"#7f1d1d\", background: \"#fef2f2\", border: \"#fecaca\" };\n  }\n\n  function formatTime(value) {\n    if (!value) return \"--\";\n    const date = new Date(String(value).replace(\" \", \"T\"));\n    if (Number.isNaN(date.getTime())) return String(value);\n    return date.toLocaleTimeString(\"vi-VN\", { hour: \"2-digit\", minute: \"2-digit\" });\n  }\n\n  /* =========================================================\n     LOWCODER DATA BINDING\n     Lowcoder exposes a global `Lowcoder` object with:\n       - Lowcoder.subscribe(handler) -> handler({ model }) fires\n         immediately with current data AND every time it changes\n       - Lowcoder.updateModel(patch) -> pushes data back to the app\n     This replaces the old bare `model` / setInterval polling,\n     which is not part of the actual Custom Component API and is\n     why data never showed up (\"Không có dữ liệu trạm\").\n  ========================================================= */\n  function applyModel(rawModel) {\n    try {\n      const data = rawModel || {};\n      stations = safeArray(data.stations);\n      historyData = safeArray(data.history);\n\n      let stateId = data.selectedStationId;\n      if (stateId && typeof stateId === \"object\") {\n        if (stateId.value !== undefined) stateId = stateId.value;\n        else if (stateId.data !== undefined) stateId = stateId.data;\n      }\n\n      selectedStationId = safeNumber(stateId);\n\n      if (selectedStationId === null && stations.length > 0) {\n        selectedStationId = safeNumber(stations[0].id);\n      }\n\n      const index = stations.findIndex(\n        station => safeNumber(station.id) === selectedStationId\n      );\n      if (index >= 0) currentIndex = index;\n      else if (currentIndex >= stations.length) currentIndex = 0;\n\n      console.log(\"IOC stations:\", stations);\n      console.log(\"IOC history:\", historyData);\n      console.log(\"IOC selectedStationId:\", selectedStationId);\n\n      renderStationSelect();\n      updateStation();\n    } catch (error) {\n      console.error(\"Lỗi xử lý dữ liệu từ Lowcoder:\", error);\n    }\n  }\n\n  function updateSelectedStation(stationId) {\n    selectedStationId = safeNumber(stationId);\n    if (typeof Lowcoder !== \"undefined\" && typeof Lowcoder.updateModel === \"function\") {\n      Lowcoder.updateModel({ selectedStationId: selectedStationId }).catch(function (error) {\n        console.warn(\"Không thể updateModel:\", error);\n      });\n    } else {\n      console.warn(\"Lowcoder.updateModel không khả dụng (component chưa chạy trong Lowcoder?)\");\n    }\n  }\n\n  /* =========================================================\n     CURRENT STATION\n  ========================================================= */\n  function getCurrentStation() {\n    if (!stations.length) return null;\n    return stations[currentIndex] || stations[0];\n  }\n\n  /* =========================================================\n     RENDER SELECT\n  ========================================================= */\n  function renderStationSelect() {\n    const select = document.getElementById(\"stationSelect\");\n    if (!select) return;\n\n    select.innerHTML = \"\";\n    stations.forEach((station, index) => {\n      const option = document.createElement(\"option\");\n      option.value = station.id;\n      option.textContent = `${index + 1}. ${getStationName(station)}`;\n      select.appendChild(option);\n    });\n\n    if (selectedStationId !== null) {\n      select.value = String(selectedStationId);\n    }\n  }\n\n  /* =========================================================\n     UPDATE STATION UI\n  ========================================================= */\n  function updateStation() {\n    const station = getCurrentStation();\n    if (!station) {\n      showEmptyState();\n      return;\n    }\n\n    const aqi = safeNumber(station.aqius);\n    const aqiInfo = getAqiInfo(aqi);\n\n    selectedStationId = safeNumber(station.id);\n\n    document.getElementById(\"stationName\").textContent = getStationName(station);\n    document.getElementById(\"stationLocation\").textContent = getLocationText(station).toUpperCase();\n\n    const lat = safeNumber(station.latitude ?? station.lat);\n    const lon = safeNumber(station.longitude ?? station.lon);\n    document.getElementById(\"stationCoordinates\").textContent =\n      (lat !== null && lon !== null) ? `${lat.toFixed(5)}, ${lon.toFixed(5)}` : \"--\";\n\n    const updatedAt = station.pollution_updated_at || station.ts_vn || station.weather_updated_at;\n    document.getElementById(\"lastUpdated\").textContent =\n      updatedAt ? `Cập nhật: ${formatTime(updatedAt)}` : \"Chưa có thời gian cập nhật\";\n\n    document.getElementById(\"aqiValue\").textContent = displayValue(aqi);\n    const aqiLabel = document.getElementById(\"aqiLabel\");\n    aqiLabel.textContent = aqiInfo.label;\n    aqiLabel.style.color = aqiInfo.color;\n    aqiLabel.style.background = aqiInfo.background;\n    aqiLabel.style.borderColor = aqiInfo.border;\n\n    const ring = document.getElementById(\"aqiRing\");\n    ring.style.background = `conic-gradient(${aqiInfo.color} 0deg, ${aqiInfo.color} 360deg)`;\n\n    document.getElementById(\"mainPollutant\").textContent = formatPollutantName(station.mainus);\n\n    document.getElementById(\"temperature\").textContent = displayValue(safeNumber(station.temperature), \"°C\");\n    document.getElementById(\"humidity\").textContent = displayValue(safeNumber(station.humidity), \"%\");\n    const wind = safeNumber(station.wind_speed);\n    document.getElementById(\"wind\").textContent = wind !== null ? `${wind} m/s` : \"--\";\n    document.getElementById(\"uv\").textContent = \"--\";\n\n    document.getElementById(\"infoCity\").textContent = getLocationText(station).replace(\", Việt Nam\", \"\");\n    document.getElementById(\"infoCountry\").textContent = station.country || \"Vietnam\";\n    document.getElementById(\"infoLat\").textContent = lat !== null ? lat.toFixed(5) : \"--\";\n    document.getElementById(\"infoLon\").textContent = lon !== null ? lon.toFixed(5) : \"--\";\n\n    const online = isStationOnline(station);\n    document.getElementById(\"infoStatus\").textContent = online ? \"Online\" : \"Offline\";\n    document.getElementById(\"infoStatus\").style.color = online ? \"#059669\" : \"#dc2626\";\n    document.getElementById(\"statusText\").textContent = online ? \"Đang hoạt động\" : \"Mất kết nối\";\n    document.getElementById(\"statusDot\").style.background = online ? \"#10b981\" : \"#ef4444\";\n\n    document.getElementById(\"stationCounter\").textContent = `Trạm ${currentIndex + 1} / ${stations.length}`;\n    document.getElementById(\"prevButton\").disabled = currentIndex <= 0;\n    document.getElementById(\"nextButton\").disabled = currentIndex >= stations.length - 1;\n\n    document.getElementById(\"stationSelect\").value = String(station.id);\n\n    renderPollutants(station);\n    renderAQIChart(station);\n  }\n\n  function isStationOnline(station) {\n    const value = station.status;\n    if (value === \"offline\" || value === \"Offline\" || value === false) return false;\n\n    const updatedAt = station.pollution_updated_at || station.weather_updated_at;\n    if (!updatedAt) return true;\n\n    const date = new Date(String(updatedAt).replace(\" \", \"T\"));\n    if (Number.isNaN(date.getTime())) return true;\n\n    const age = Date.now() - date.getTime();\n    return age <= 2 * 60 * 60 * 1000;\n  }\n\n  function formatPollutantName(value) {\n    if (!value) return \"--\";\n    const map = {\n      \"p1\": \"PM10\", \"p2\": \"PM2.5\", \"p3\": \"O₃\", \"p4\": \"CO\", \"p5\": \"SO₂\", \"p6\": \"NO₂\",\n      \"pm25\": \"PM2.5\", \"pm10\": \"PM10\", \"o3\": \"O₃\", \"co\": \"CO\", \"so2\": \"SO₂\", \"no2\": \"NO₂\"\n    };\n    return map[String(value).toLowerCase()] || String(value).toUpperCase();\n  }\n\n  const pollutantDefinitions = {\n    pm25: { name: \"PM2.5\", fullName: \"Bụi mịn PM2.5\", description: \"Các hạt bụi có đường kính khí động học không lớn hơn 2.5 micromet.\", unit: \"µg/m³\" },\n    pm10: { name: \"PM10\", fullName: \"Bụi PM10\", description: \"Các hạt vật chất dạng bụi có đường kính khí động học không lớn hơn 10 micromet.\", unit: \"µg/m³\" },\n    no2: { name: \"NO₂\", fullName: \"Nitrogen Dioxide\", description: \"Nitơ dioxide thường phát sinh từ quá trình đốt nhiên liệu và giao thông.\", unit: \"ppb\" },\n    so2: { name: \"SO₂\", fullName: \"Sulfur Dioxide\", description: \"Sulfur dioxide thường liên quan đến quá trình đốt nhiên liệu chứa lưu huỳnh.\", unit: \"ppb\" },\n    co: { name: \"CO\", fullName: \"Carbon Monoxide\", description: \"Carbon monoxide sinh ra chủ yếu từ quá trình đốt cháy không hoàn toàn.\", unit: \"ppm\" },\n    o3: { name: \"O₃\", fullName: \"Ozone\", description: \"Ozone tầng thấp hình thành từ các phản ứng quang hóa trong khí quyển.\", unit: \"ppb\" }\n  };\n\n  function renderPollutants(station) {\n    const container = document.getElementById(\"pollutantGrid\");\n    container.innerHTML = \"\";\n\n    const fields = [\n      { key: \"pm25\", className: \"warning\" },\n      { key: \"pm10\", className: \"warning\" },\n      { key: \"no2\", className: \"\" },\n      { key: \"so2\", className: \"\" },\n      { key: \"co\", className: \"\" },\n      { key: \"o3\", className: \"warning\" }\n    ];\n\n    fields.forEach(field => {\n      const definition = pollutantDefinitions[field.key];\n      const rawValue = station[field.key];\n      const value = safeNumber(rawValue);\n\n      const item = document.createElement(\"div\");\n      item.className = `pollutant ${field.className}`;\n      item.innerHTML = `\n        <div class=\"pollutant-top\">\n          <div class=\"pollutant-name\">${definition.name}</div>\n          <span class=\"material-symbols-outlined info-icon\">info</span>\n        </div>\n        <div class=\"pollutant-value\">\n          ${value !== null ? value : \"--\"}\n          ${value !== null ? `<span class=\"pollutant-unit\">${definition.unit}</span>` : \"\"}\n        </div>\n        <div class=\"pollutant-tooltip\">\n          <div class=\"tooltip-title\">${definition.name} — ${definition.fullName}</div>\n          <div class=\"tooltip-description\">${definition.description}</div>\n          <div class=\"tooltip-unit\">Đơn vị đo: ${definition.unit}</div>\n        </div>\n      `;\n      container.appendChild(item);\n    });\n  }\n\n  function getStationHistory() {\n    const unique = new Map();\n\n    historyData.forEach(row => {\n      if (!row || !row.ts_vn) return;\n      const time = String(row.ts_vn);\n      const aqi = safeNumber(row.aqius);\n      if (aqi === null) return;\n      unique.set(time, { ts_vn: time, aqius: aqi });\n    });\n\n    return Array.from(unique.values()).sort(\n      (a, b) => new Date(String(a.ts_vn).replace(\" \", \"T\")) - new Date(String(b.ts_vn).replace(\" \", \"T\"))\n    );\n  }\n\n  function renderAQIChart(station) {\n    const canvas = document.getElementById(\"aqi24hChart\");\n    if (!canvas) return;\n\n    if (typeof Chart === \"undefined\") {\n      console.error(\"Chart.js chưa được load.\");\n      return;\n    }\n\n    if (aqi24hChart) {\n      aqi24hChart.destroy();\n      aqi24hChart = null;\n    }\n\n    const history = getStationHistory();\n    const aqi = safeNumber(station.aqius);\n    const aqiInfo = getAqiInfo(aqi);\n\n    document.getElementById(\"chartStationName\").textContent = getStationName(station);\n    if (history.length === 0) return;\n\n    const labels = history.map(row => formatTime(row.ts_vn));\n    const values = history.map(row => row.aqius);\n\n    aqi24hChart = new Chart(canvas, {\n      type: \"line\",\n      data: {\n        labels: labels,\n        datasets: [{\n          label: \"AQI\",\n          data: values,\n          borderColor: aqiInfo.color,\n          backgroundColor: aqiInfo.color + \"18\",\n          borderWidth: 2.5,\n          fill: true,\n          tension: 0.35,\n          pointRadius: 3,\n          pointHoverRadius: 6,\n          pointBorderWidth: 2,\n          pointBackgroundColor: \"#ffffff\",\n          pointBorderColor: aqiInfo.color\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        interaction: { intersect: false, mode: \"index\" },\n        plugins: {\n          legend: { display: false },\n          tooltip: {\n            backgroundColor: \"#172033\",\n            titleColor: \"#ffffff\",\n            bodyColor: \"#dbe4ef\",\n            padding: 10,\n            displayColors: false,\n            callbacks: {\n              label: function (context) { return \"AQI: \" + context.parsed.y; }\n            }\n          }\n        },\n        scales: {\n          x: {\n            grid: { display: false },\n            border: { display: false },\n            ticks: { color: \"#8291a6\", font: { size: 10 }, maxTicksLimit: 8 }\n          },\n          y: {\n            beginAtZero: false,\n            suggestedMin: 0,\n            suggestedMax: 100,\n            border: { display: false },\n            grid: { color: \"#edf1f5\" },\n            ticks: { color: \"#8291a6\", font: { size: 10 }, stepSize: 20 }\n          }\n        }\n      }\n    });\n  }\n\n  function changeStation(id) {\n    const stationId = safeNumber(id);\n    const index = stations.findIndex(station => safeNumber(station.id) === stationId);\n    if (index < 0) return;\n\n    currentIndex = index;\n    updateSelectedStation(stationId);\n    updateStation();\n  }\n\n  function previousStation() {\n    if (currentIndex <= 0) return;\n    currentIndex--;\n    const station = stations[currentIndex];\n    updateSelectedStation(station.id);\n    updateStation();\n  }\n\n  function nextStation() {\n    if (currentIndex >= stations.length - 1) return;\n    currentIndex++;\n    const station = stations[currentIndex];\n    updateSelectedStation(station.id);\n    updateStation();\n  }\n\n  function openStationModal() {\n    document.getElementById(\"stationModal\").classList.add(\"show\");\n    renderStationList();\n  }\n\n  function closeStationModal() {\n    document.getElementById(\"stationModal\").classList.remove(\"show\");\n  }\n\n  function renderStationList() {\n    const list = document.getElementById(\"stationList\");\n    list.innerHTML = \"\";\n\n    stations.forEach((station, index) => {\n      const item = document.createElement(\"div\");\n      item.className = \"station-option\" + (index === currentIndex ? \" active\" : \"\");\n      item.onclick = function () {\n        currentIndex = index;\n        updateSelectedStation(station.id);\n        updateStation();\n        closeStationModal();\n      };\n\n      item.innerHTML = `\n        <div class=\"station-option-left\">\n          <div class=\"station-option-name\">${getStationName(station)}</div>\n          <div class=\"station-option-location\">${getLocationText(station)}</div>\n        </div>\n        <div class=\"station-aqi\">\n          ${safeNumber(station.aqius) !== null ? \"AQI \" + station.aqius : \"AQI --\"}\n        </div>\n      `;\n      list.appendChild(item);\n    });\n  }\n\n  document.getElementById(\"stationModal\").addEventListener(\"click\", function (event) {\n    if (event.target === this) closeStationModal();\n  });\n\n  function showEmptyState() {\n    document.getElementById(\"stationName\").textContent = \"Không có dữ liệu trạm\";\n    document.getElementById(\"aqiValue\").textContent = \"--\";\n    document.getElementById(\"aqiLabel\").textContent = \"CHƯA CÓ DỮ LIỆU\";\n    document.getElementById(\"mainPollutant\").textContent = \"--\";\n    document.getElementById(\"stationCounter\").textContent = \"Trạm 0 / 0\";\n    document.getElementById(\"statusText\").textContent = \"Không có dữ liệu\";\n    renderPollutants({});\n  }\n\n  /* =========================================================\n     BOOTSTRAP: subscribe to Lowcoder data changes\n  ========================================================= */\n  function initLowcoderSubscription() {\n    if (typeof Lowcoder === \"undefined\" || typeof Lowcoder.subscribe !== \"function\") {\n      console.error(\"Không tìm thấy global `Lowcoder`. Component này phải chạy bên trong iframe của Lowcoder Custom Component.\");\n      showEmptyState();\n      return;\n    }\n\n    // subscribe() fires immediately with the current model, and again\n    // on every change — this replaces the old model/setInterval polling.\n    Lowcoder.subscribe(function (payload) {\n      applyModel(payload && payload.model);\n    });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initLowcoderSubscription);\n  } else {\n    initLowcoderSubscription();\n  }\n</script>\n</body>\n</html>","showDataLoadingIndicators":false,"preventStyleOverwriting":false,"appliedThemeId":"","version":"latest"},"name":"custom1"}}},"containerSize":{"height":107,"width":24},"containerRowCount":106,"showDataLoadingIndicators":false,"preventStyleOverwriting":false,"appliedThemeId":"","version":"latest"}},"queries":[{"compType":"postgres","comp":{"commandType":"INSERT","command":{"table":"","changeSet":{"compType":"KEY_VALUE_PAIRS","comp":[{"column":"","value":""}]}},"mode":"SQL","sql":"SELECT\n  s.id,\n  s.name,\n  s.city,\n  s.state,\n  s.country,\n  s.latitude,\n  s.longitude,\n  pr.aqius,\n  pr.aqicn,\n  pr.mainus,\n  pr.p2 AS pm25,\n  pr.p1 AS pm10,\n  pr.n2 AS no2,\n  pr.s2 AS so2,\n  pr.co,\n  pr.o3,\n  pr.ts_vn AS pollution_updated_at,\n  wr.tp AS temperature,\n  wr.hu AS humidity,\n  wr.ws AS wind_speed,\n  wr.ic AS weather_icon,\n  wr.ts_vn AS weather_updated_at\nFROM stations s\nLEFT JOIN LATERAL (\n  SELECT * FROM pollution_readings p\n  WHERE p.station_id = s.id\n  ORDER BY p.ts DESC\n  LIMIT 1\n) pr ON true\nLEFT JOIN LATERAL (\n  SELECT * FROM weather_readings w\n  WHERE w.station_id = s.id\n  ORDER BY w.ts DESC\n  LIMIT 1\n) wr ON true\nORDER BY s.id;","disablePreparedStatement":false},"id":"zzll1qg5vp01xlsga25bifq4","name":"get_stations_latest","order":1787746399311,"datasourceId":"6a76284f3dce5f3fbb6b72ac","triggerType":"automatic","onEvent":[],"notification":{"showSuccess":true,"showFail":true,"fail":[{}]},"timeout":"","confirmationModal":{},"variables":[],"periodic":false,"periodicTime":"","cancelPrevious":false,"depQueryName":"","delayTime":""},{"compType":"postgres","comp":{"commandType":"INSERT","command":{"table":"","changeSet":{"compType":"KEY_VALUE_PAIRS","comp":[{"column":"","value":""}]}},"mode":"SQL","sql":"SELECT ts_vn, aqius\nFROM pollution_readings\nWHERE station_id = {{ selectedStationId.value }}\n  AND ts >= NOW() - INTERVAL '24 hours'\nORDER BY ts ASC;","disablePreparedStatement":false},"id":"4ya4435t1ntgxmhv6bnswwhc","name":"get_station_history","order":1787747130590,"datasourceId":"6a76284f3dce5f3fbb6b72ac","triggerType":"automatic","onEvent":[],"notification":{"showSuccess":true,"showFail":true,"fail":[{}]},"timeout":"","confirmationModal":{},"variables":[],"periodic":false,"periodicTime":"","cancelPrevious":false,"depQueryName":"","delayTime":""}],"tempStates":[{"name":"selectedStationId","value":"1"}],"refTree":{"value":"","items":[{"value":"get_stations_latest"},{"value":"get_station_history"},{"value":"selectedStationId"}]},"hooks":[{"compType":"urlParams","comp":{},"name":"url"},{"compType":"dayJsLib","comp":{},"name":"dayjs"},{"compType":"lodashJsLib","comp":{},"name":"_"},{"compType":"utils","comp":{},"name":"utils"},{"compType":"message","comp":{},"name":"message"},{"compType":"toast","comp":{},"name":"toast"},{"compType":"localStorage","comp":{},"name":"localStorage"},{"compType":"currentUser","comp":{},"name":"currentUser"},{"compType":"screenInfo","comp":{},"name":"screenInfo"},{"compType":"theme","comp":{},"name":"theme"}],"settings":{"title":"","description":"","category":"Business","showHeaderInPublic":true,"themeId":"default","preventAppStylesOverwriting":true,"disableCollision":false,"lowcoderCompVersion":"latest","maxWidth":{"dropdown":"1440","input":"1440"},"gridRowCount":"Infinity","gridPaddingX":"0","gridPaddingY":"0"},"preload":{"script":"","css":"","globalCSS":""}}}